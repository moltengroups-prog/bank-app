# ── Admin / Vercel ────────────────────────────────────────────────
# Set these in Vercel → Settings → Environment Variables for production.
# For local dev, copy to .env.local (git-ignored).

# ── Browser-side (NEXT_PUBLIC_ prefix required) ───────────────────

# Railway backend origin — used by the admin browser code for API + socket calls
NEXT_PUBLIC_API_URL=https://your-app.up.railway.app

# WebSocket URL — must be direct Railway URL (Vercel cannot proxy WebSockets)
NEXT_PUBLIC_SOCKET_URL=https://your-app.up.railway.app

# ── Server-side only (no NEXT_PUBLIC_ prefix) ─────────────────────

# Used by Next.js rewrite rules to proxy /api/* → Railway in dev/SSR
# Not needed if NEXT_PUBLIC_API_URL is set (production calls Railway directly)
BACKEND_URL=https://your-app.up.railway.app
