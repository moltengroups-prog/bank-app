# ── Server / Railway ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains real secrets.

# Railway assigns PORT automatically in production — omit or set to 8000 locally
PORT=8000

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRE=30d

# ── Wire transfer encryption ──────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of wire recipient account numbers
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WIRE_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ── Email (Resend) ────────────────────────────────────────────────
# Get your API key from https://resend.com
# When unset, OTP codes are logged to the server terminal (development fallback).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a domain you have verified in Resend. Example: noreply@yourdomain.com
EMAIL_FROM=Bank of Molten <noreply@bankofmolten.com>

# ── CORS — allowed frontend origins ──────────────────────────────
# Comma-separated. Add all Vercel preview + production URLs.
# When unset, defaults to http://localhost:3000 (client) and :3001 (admin).
CLIENT_URL=https://your-client.vercel.app
ADMIN_URL=https://your-admin.vercel.app
