# ── Client / Vercel ───────────────────────────────────────────────
# CRA requires the REACT_APP_ prefix for env vars to be embedded at build time.
# Set these in Vercel → Settings → Environment Variables for production.
# For local dev, copy to .env.local (git-ignored).

# Full API URL including /api path
REACT_APP_API_URL=https://your-app.up.railway.app/api

# Backend origin for WebSocket connection (no /api suffix)
REACT_APP_SOCKET_URL=https://your-app.up.railway.app
